{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOriginalsWriteRenditions",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::<PROD_BUCKET>/crews/*"
    },
    {
      "Sid": "FindTheBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::<PROD_BUCKET>"
    }
  ]
}
