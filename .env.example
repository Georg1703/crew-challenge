# Copy to .env for local development: `cp .env.example .env` (make setup does this).
# Every variable the app reads is listed here with a comment. Never put real secrets in this file.
# Production values live in the server's root-only /opt/cc/.env (see docs/runbooks/aws-setup.md).

# --- Django ---------------------------------------------------------------
# config.settings.local | config.settings.test | config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.local
# Any long random string locally; unique and secret in production.
DJANGO_SECRET_KEY=change-me-local-only
DJANGO_DEBUG=true
# Comma-separated host names the app answers to.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins trusted for CSRF (scheme + host + port).
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Public URL of the app, used in invite links and push notifications.
APP_PUBLIC_URL=http://localhost:5173

# --- Database (Postgres container locally and in production) ----------------
POSTGRES_DB=crew_challenges
POSTGRES_USER=crew
POSTGRES_PASSWORD=crew-local-password
DATABASE_URL=postgres://crew:crew-local-password@db:5432/crew_challenges

# --- Redis / Celery ---------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# --- AWS --------------------------------------------------------------------
AWS_REGION=eu-central-1
# Local: name of your AWS CLI profile with access to the dev bucket only.
AWS_PROFILE=cc-dev
# Production only: key of the least-privilege IAM user (leave empty locally).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Media bucket for original uploads and HLS renditions.
MEDIA_BUCKET=cc-dev-media
# CloudFront distribution domain for playback (empty locally until M2).
MEDIA_CDN_DOMAIN=
# CloudFront signed cookies (M2): key pair id and path to the private key file.
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY_PATH=
# MediaConvert (M2): role ARN MediaConvert assumes to read/write the media bucket.
MEDIACONVERT_ROLE_ARN=
# Shared secret that authenticates MediaConvert job-state webhooks.
MEDIACONVERT_WEBHOOK_SECRET=
# Backups bucket (production only).
BACKUP_BUCKET=

# --- Web Push (M4) ----------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com

# --- Crew defaults ----------------------------------------------------------
DEFAULT_CREW_TIMEZONE=Europe/Chisinau
