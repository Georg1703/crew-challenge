# Copy to .env for local development: `cp .env.example .env` (make setup does this).
# Every variable the app reads is listed here with a comment. Never put real secrets in this file.
# Production values live in the server's root-only /opt/cc/.env.

# --- Django ---------------------------------------------------------------
# config.settings.local | config.settings.test | config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.local
# Any long random string locally; unique and secret in production.
DJANGO_SECRET_KEY=change-me-local-only
DJANGO_DEBUG=true
# Comma-separated host names the app answers to.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins trusted for CSRF (scheme + host + port).
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Public URL of the app, used in invite links and push notifications.
APP_PUBLIC_URL=http://localhost:5173

# --- Database and Redis (compose containers) -----------------------------------
# The addresses below are as seen from your machine (make check, make e2e, a local runserver).
# Inside compose the containers use the service names (db, redis); compose.yaml sets those.
POSTGRES_DB=crew_challenges
POSTGRES_USER=crew
POSTGRES_PASSWORD=crew-local-password
# Ports compose publishes on localhost. If one is taken, change it here and in the URLs below.
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgres://crew:crew-local-password@localhost:5432/crew_challenges
# Database used by `make check` / pytest (pytest creates its own test_ database on this server).
TEST_DATABASE_URL=postgres://crew:crew-local-password@localhost:5432/crew_challenges
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Shared cache (rate limits).
CACHE_URL=redis://localhost:6379/3

# --- AWS --------------------------------------------------------------------
AWS_REGION=eu-central-1
# Local: name of your AWS CLI profile with access to the dev bucket only.
AWS_PROFILE=cc-dev
# Production only: key of the least-privilege IAM user (leave empty locally).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Media bucket for original uploads and HLS renditions.
MEDIA_BUCKET=cc-dev-media
# s3 in every real environment; tests force "memory".
OBJECT_STORAGE_BACKEND=s3
# Production: media.<app host> (CloudFront, signed cookies). Empty locally: presigned URLs.
MEDIA_CDN_DOMAIN=
# CloudFront signed cookies: the public key's id in the key group, and the private key file.
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY_PATH=
# Videos: off (play as uploaded; the local default) | mediaconvert (production; locally costs
# a little per minute of video). Celery polls each job; there is no webhook.
TRANSCODER_BACKEND=off
# MediaConvert: role ARN MediaConvert assumes to read/write the media bucket.
MEDIACONVERT_ROLE_ARN=
# Backups bucket (production only).
BACKUP_BUCKET=

# --- Web Push --------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com

# --- Crew defaults ----------------------------------------------------------
DEFAULT_CREW_TIMEZONE=Europe/Chisinau
